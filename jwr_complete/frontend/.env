# Frontend Environment Variables
# Vite exposes variables prefixed with VITE_ to the browser

# Backend API URL — must match where your Express server is running
VITE_API_URL=http://localhost:3000

# Google Sign-In — OAuth 2.0 Web client ID (Google Cloud Console)
# Must match GOOGLE_CLIENT_ID on the backend
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Cloudinary CDN — gallery images served from here (not public folder)
VITE_CLOUDINARY_CLOUD_NAME=dvadwvpco
