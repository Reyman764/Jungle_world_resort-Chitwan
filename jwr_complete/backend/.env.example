# ============================================================
# Jungle World Resort API — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to git.
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ── Frontend URLs (CORS whitelist) ──────────────────────────
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ── Database (PostgreSQL / Supabase) ────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jungle_world
DB_USER=jungle_user
DB_PASSWORD=your_strong_password_here
# Supabase: use the connection string from Project Settings → Database
DATABASE_URL=postgresql://postgres.oumhsikmiwymjibwknkn:%2623messiisgoat@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── JWT Auth ────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=jungle_resort_ultra_secure_access_token_key_2026_!
JWT_REFRESH_SECRET=jungle_resort_long_term_refresh_token_key_9988_!JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ══════════════════════════════════════════════════════════
# ✅ SENDGRID OTP (Required for booking email verification)
# ══════════════════════════════════════════════════════════
# 1. Create account at https://sendgrid.com (free tier: 100 emails/day)
# 2. Go to Settings → API Keys → Create API Key (Full Access)
# 3. Copy the key that starts with SG.  (shown ONCE — save it now)
# 4. Go to Settings → Sender Authentication → Verify a Single Sender
#    OR set up Domain Authentication for noreply@jungleworldresort.com
# 5. Paste your values below

SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@jungleworldresort.com
SENDGRID_SUPPORT_EMAIL=support@jungleworldresort.com
# ══════════════════════════════════════════════════════════

# ── Email — Gmail SMTP (alternative to SendGrid) ─────────
# docs/GMAIL_SMTP_SETUP.md for setup instructions
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Jungle World Resort" <your@gmail.com>

# ── Google Sign-In ────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── SMS — Twilio (optional) ──────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# ── Payment — Khalti ────────────────────────────────────
KHALTI_PUBLIC_KEY=test_public_key_xxxxxxxxxxxxxxxxxxxxxxxx
KHALTI_SECRET_KEY=test_secret_key_xxxxxxxxxxxxxxxxxxxxxxxx
KHALTI_BASE_URL=https://khalti.com/api/v2

# ── Payment — Stripe ────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin ────────────────────────────────────────────────
ADMIN_SECRET_KEY=your-admin-secret-key-here

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug

# ── Encryption ──────────────────────────────────────────
ENCRYPTION_KEY=32-character-encryption-key-here!

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Third-Party ─────────────────────────────────────────
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
SENTRY_DSN=https://xxxx@sentry.io/xxxx
