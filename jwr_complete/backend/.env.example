# ============================================================
# Jungle World Resort — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git (it's in .gitignore).
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ── Frontend URLs (CORS whitelist) ──────────────────────────
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ── Database (PostgreSQL / Supabase) ────────────────────────
# Use the Supabase connection string from:
#   Project Settings → Database → Connection String (Session mode / port 5432)
# If your password contains special characters, URL-encode them first.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# ── JWT Auth ────────────────────────────────────────────────
# Generate secure random keys with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# These are REQUIRED in production — the server refuses to start without them.
JWT_SECRET=change-me-use-random-48-char-hex
JWT_REFRESH_SECRET=change-me-use-different-random-48-char-hex
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ── Email — Gmail SMTP ──────────────────────────────────────
# See docs/GMAIL_SMTP_SETUP.md for step-by-step instructions.
# SMTP_PASS must be a Google App Password (16 chars), NOT your Gmail password.
# Check health at: GET /api/health/email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-resort-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Jungle World Resort" <your-resort-gmail@gmail.com>

# ── Image Storage — Cloudinary (optional) ──────────────────
# If not set, uploaded images fall back to Supabase Storage.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google OAuth (optional) ─────────────────────────────────
# Required only if you want Google Sign-In for guests.
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxx.apps.googleusercontent.com

# ── Rate Limiting (optional overrides) ──────────────────────
# Booking creation: default 5 attempts per 1 hour per IP.
BOOKING_RATE_LIMIT=5
BOOKING_RATE_WINDOW_HOURS=1
# Public booking lookup: default 20 attempts per 15 min per IP.
BOOKING_LOOKUP_RATE_LIMIT=20

# ── Staff Seeding (seed-only — not read at runtime) ─────────
# Set these before running `npm run seed` to use specific passwords
# instead of random ones.  Remove after seeding.
# SEED_ADMIN_PASSWORD=your-admin-password
# SEED_MANAGER_PASSWORD=your-manager-password
# SEED_STAFF_PASSWORD=your-staff-password
